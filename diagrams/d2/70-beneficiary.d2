# Resala Charity — Beneficiary module (Strategy distribution policies)
vars: {
  d2-config: {
    layout-engine: tala
    theme-id: 1
  }
}

beneficiary: com.resala.beneficiary {
  style.fill: "#F5F4F0"
  style.stroke: "#C8C5BA"
  style.font-size: 15
  style.bold: true

  BeneficiaryService: {
    shape: class
    "-repository": BeneficiaryRepository
    "-distributionPolicy": DistributionPolicy
    "+add(Beneficiary)": Beneficiary
    "+update(Beneficiary)": Beneficiary
    "+getBeneficiary(long)": Beneficiary
    "+delete(long)": void
    "+recordDistribution(long, Long, String, int, LocalDate, String)": Distribution
    "+getDistributionHistory(long)": "List<Distribution>"
    "+previewDistribution(int)": "Map<Beneficiary, Integer>"
    "+distributeByPolicy(String, int, Long, LocalDate, String)": "List<Distribution>"
    "+setDistributionPolicy(DistributionPolicy)": void
    "+getImpactScore(long)": int
    "+addNeedType(String)": NeedType
  }

  BeneficiaryRepository: {
    shape: class
    "«interface»": ""
    "+save(Beneficiary)": Beneficiary
    "+findById(long)": "Optional<Beneficiary>"
    "+findAll()": "List<Beneficiary>"
    "+delete(long)": void
    "+saveDistribution(Distribution)": Distribution
    "+findDistributionsByBeneficiary(long)": "List<Distribution>"
    "+findAllDistributions()": "List<Distribution>"
    "+findAllNeedTypes()": "List<NeedType>"
    "+saveNeedType(NeedType)": NeedType
  }

  Distribution: {
    shape: class
    "-id": long
    "-beneficiaryId": long
    "-donationId": Long
    "-itemDescription": String
    "-quantity": int
    "-distributionDate": LocalDate
    "-notes": String
  }

  policy: "«pattern» Strategy — distribution policies" {
    style.stroke-dash: 5
    style.stroke: "#174E5B"
    style.fill: "#FDFDFB"
    style.font-size: 14
    style.font-color: "#174E5B"
    style.bold: true

    DistributionPolicy: {
      shape: class
      "«interface» — Strategy": ""
      "+allocate(List<Beneficiary>, int)": "Map<Beneficiary, Integer>"
      "+getName()": String
    }
    ByNeedDistributionPolicy: { shape: class; "«strategy» proportional to household size": "" }
    EqualDistributionPolicy: { shape: class; "«strategy» even split, remainder round-robin": "" }
    FifoDistributionPolicy: { shape: class; "«strategy» earliest-registered first, quota per beneficiary": ""; "-quotaPerBeneficiary": int }
  }
}

sqlite: persistence.sqlite {
  style.fill: "#F5F4F0"
  style.stroke: "#C8C5BA"
  style.font-size: 15
  style.bold: true

  SqliteBeneficiaryRepository: {
    shape: class
    "-BENEFICIARY_MAPPER": "RowMapper<Beneficiary>"
    "-DISTRIBUTION_MAPPER": "RowMapper<Distribution>"
  }
}

external: Collaborators {
  style.fill: "#FDFDFB"
  style.stroke: "#D8D5C9"
  style.font-size: 14
  style.bold: true

  Beneficiary: { shape: class; "«model» Beneficiary": "" }
  NeedType: { shape: class; "«model» NeedType": "" }
  JdbcRepository: { shape: class; "«core abstract» JdbcRepository": "" }
}

beneficiary.policy.ByNeedDistributionPolicy -> beneficiary.policy.DistributionPolicy: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
beneficiary.policy.EqualDistributionPolicy -> beneficiary.policy.DistributionPolicy: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
beneficiary.policy.FifoDistributionPolicy -> beneficiary.policy.DistributionPolicy: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }

beneficiary.BeneficiaryService -> beneficiary.BeneficiaryRepository: ""
beneficiary.BeneficiaryService -> beneficiary.policy.DistributionPolicy: "pluggable policy" { style.font-size: 12; style.font-color: "#6B675C" }
beneficiary.BeneficiaryService -> external.Beneficiary: ""
beneficiary.BeneficiaryService -> external.NeedType: "need-types lookup" { style.font-size: 12; style.font-color: "#6B675C" }
beneficiary.BeneficiaryService -> beneficiary.Distribution: "records" { style.font-size: 12; style.font-color: "#6B675C" }

beneficiary.Distribution -> external.Beneficiary: "beneficiaryId" { style.font-size: 12; style.font-color: "#6B675C" }
beneficiary.BeneficiaryRepository -> beneficiary.Distribution: "" { style.stroke-dash: 4 }
beneficiary.BeneficiaryRepository -> external.Beneficiary: "" { style.stroke-dash: 4 }
beneficiary.BeneficiaryRepository -> external.NeedType: "" { style.stroke-dash: 4 }

sqlite.SqliteBeneficiaryRepository -> beneficiary.BeneficiaryRepository: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
sqlite.SqliteBeneficiaryRepository -> external.JdbcRepository: extends { target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
