# Resala Charity — Notification module (Observer + Strategy)
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
  }
}

direction: right

notification: com.resala.notification {
  style.fill: "#F5F4F0"
  style.stroke: "#C8C5BA"
  style.font-size: 15
  style.bold: true

  strategy: "«pattern» Strategy" {
    style.stroke-dash: 5
    style.stroke: "#174E5B"
    style.fill: "#FDFDFB"
    style.font-size: 14
    style.font-color: "#174E5B"
    style.bold: true

    NotificationStrategy: {
      shape: class
      "«interface»": ""
      "+send(String, String, String)": void
    }
    EmailStrategy: { shape: class; "+send(...)": void }
    SmsStrategy: { shape: class; "+send(...)": void }
    SocialStrategy: { shape: class; "+send(...)": void }
  }

  Notifier: {
    shape: class
    "-strategy": NotificationStrategy
    "+Notifier(NotificationStrategy)": ""
    "+setStrategy(NotificationStrategy)": void
    "+getStrategy()": NotificationStrategy
    "+send(String, String, String)": void
  }

  observer: "«pattern» Observer" {
    style.stroke-dash: 5
    style.stroke: "#174E5B"
    style.fill: "#FDFDFB"
    style.font-size: 14
    style.font-color: "#174E5B"
    style.bold: true

    DonationSubject: { shape: class; "«interface»": ""; "+addObserver(DonationObserver)": void; "+removeObserver(DonationObserver)": void }
    DonationObserver: { shape: class; "«interface»": ""; "+onDonationRecorded(Donation, Donor)": void }
    EventSubject: { shape: class; "«interface»": ""; "+addObserver(EventObserver)": void; "+removeObserver(EventObserver)": void }
    EventObserver: { shape: class; "«interface»": ""; "+onEventUpdated(Event, String)": void }

    ThankYouNotificationObserver: { shape: class; "-notifier": Notifier; "+onDonationRecorded(Donation, Donor)": void }
    EventNotificationObserver: { shape: class; "-registrationRepository": EventRegistrationRepository; "-notifier": Notifier; "+onEventUpdated(Event, String)": void }
    FeedObserver: { shape: class; "«dual observer»": ""; "-feedList": "ListView<String>"; "-statusLabel": Label; "+onDonationRecorded(Donation, Donor)": void; "+onEventUpdated(Event, String)": void }
  }
}

external: Collaborators {
  style.fill: "#FDFDFB"
  style.stroke: "#D8D5C9"
  style.font-size: 14
  style.bold: true

  DonationService: { shape: class; "«donation» implements DonationSubject": "" }
  EventService: { shape: class; "«event» implements EventSubject": "" }
  EventRegistrationRepository: { shape: class; "«event» interface": "" }
  AppShell: { shape: class; "«gui» AppShell — registers FeedObserver on both subjects": "" }
}

notification.strategy.EmailStrategy -> notification.strategy.NotificationStrategy: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
notification.strategy.SmsStrategy -> notification.strategy.NotificationStrategy: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
notification.strategy.SocialStrategy -> notification.strategy.NotificationStrategy: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
notification.Notifier -> notification.strategy.NotificationStrategy: "delegates to" { style.font-size: 12; style.font-color: "#6B675C" }

notification.observer.ThankYouNotificationObserver -> notification.observer.DonationObserver: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
notification.observer.EventNotificationObserver -> notification.observer.EventObserver: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
notification.observer.FeedObserver -> notification.observer.DonationObserver: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
notification.observer.FeedObserver -> notification.observer.EventObserver: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }

notification.observer.ThankYouNotificationObserver -> notification.Notifier: "sends via" { style.font-size: 12; style.font-color: "#6B675C" }
notification.observer.EventNotificationObserver -> notification.Notifier: "sends via" { style.font-size: 12; style.font-color: "#6B675C" }
notification.observer.EventNotificationObserver -> external.EventRegistrationRepository: "attendees" { style.font-size: 12; style.font-color: "#6B675C" }

external.DonationService -> notification.observer.DonationSubject: "notifies" { style.stroke-dash: 4; style.font-size: 12; style.font-color: "#6B675C" }
external.EventService -> notification.observer.EventSubject: "notifies" { style.stroke-dash: 4; style.font-size: 12; style.font-color: "#6B675C" }
external.AppShell -> notification.observer.FeedObserver: "registers" { style.font-size: 12; style.font-color: "#6B675C" }
