# «pattern» Adapter — payment gateway
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
  }
}
direction: right

boundary: "«pattern» Adapter — payment gateway" {
  style.stroke-dash: 6
  style.stroke: "#174E5B"
  style.fill: "#FDFDFB"
  style.font-size: 16
  style.font-color: "#174E5B"
  style.bold: true

  PaymentGateway: {
    shape: class
    "«target» interface": ""
    "+getAvailableMethods()": "List<PaymentMethod>"
    "+charge(PaymentCommand)": GatewayResult
  }
  FakePaymentGatewayAdapter: {
    shape: class
    "«adapter»": ""
    "-provider": FakePaymentProvider
    "+getAvailableMethods()": "List<PaymentMethod>"
    "+charge(PaymentCommand)": GatewayResult
  }
  FakePaymentProvider: {
    shape: class
    "«adaptee» — status codes": ""
    "+makePayment(String, long, PaymentMethod, String, String)": ProviderTxn
    "+availableMethods()": "List<PaymentMethod>"
  }
  status: "status-code mapping — 00→approved · 51/05/54→DECLINED · TIMEOUT→PROVIDER_TIMEOUT · NETWORK→PROVIDER_UNAVAILABLE" {
    shape: text
    style.font-size: 12
    style.italic: true
    style.font-color: "#174E5B"
  }

  caption: "intent — make the provider's ad-hoc API fit the PaymentGateway port used by PaymentService" {
    shape: text
    style.font-size: 13
    style.italic: true
    style.font-color: "#174E5B"
  }
}

client: { shape: class; "«client» PaymentService": "" }
boundary.FakePaymentGatewayAdapter -> boundary.PaymentGateway: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle } }
boundary.FakePaymentGatewayAdapter -> boundary.FakePaymentProvider: wraps { target-arrowhead: { shape: diamond } }
client -> boundary.PaymentGateway: ""
