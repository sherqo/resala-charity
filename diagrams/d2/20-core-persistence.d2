# Resala Charity — Core infrastructure & repository contracts
vars: {
  d2-config: {
    layout-engine: tala
    theme-id: 1
  }
}

core: com.resala.core {
  style.fill: "#F5F4F0"
  style.stroke: "#C8C5BA"
  style.font-size: 15
  style.bold: true

  singletons: "«pattern» Singleton" {
    style.stroke-dash: 5
    style.stroke: "#174E5B"
    style.fill: "#FDFDFB"
    style.font-size: 14
    style.font-color: "#174E5B"
    style.bold: true

    ConfigManager: {
      shape: class
      "«singleton»": ""
      "-instance": ConfigManager
      "-props": Properties
      "+getInstance()": ConfigManager
      "+get(String)": String
      "+get(String, String)": String
    }

    DatabaseManager: {
      shape: class
      "«singleton»": ""
      "-instance": DatabaseManager
      "-connection": Connection
      "+getInstance()": DatabaseManager
      "+getConnection()": Connection
      "+close()": void
    }

    AuditLogManager: {
      shape: class
      "«singleton»": ""
      "-INSTANCE": AuditLogManager
      "-counter": AtomicLong
      "-logs": "ObservableList<AuditLog>"
      "+getInstance()": AuditLogManager
      "+log(String, String, String, String, String, String)": void
      "+getLogs()": "ObservableList<AuditLog>"
      "+clear()": void
    }
  }

  JdbcRepository: {
    shape: class
    "«abstract»": ""
    "#conn": Connection
    "#execute(String, Object...)": int
    "#query(String, RowMapper, Object...)": "List<T>"
    "#queryOne(String, RowMapper, Object...)": "Optional<T>"
    "#insertReturnKey(String, Object...)": long
    "«functional» RowMapper<T>": "T map(ResultSet)"
  }

  TransactionManager: {
    shape: class
    "-connection": Connection
    "+TransactionManager(Connection)": ""
    "+inTransaction(Supplier<T>)": T
  }
}

contracts: Repository contracts (interfaces) {
  style.fill: "#F5F4F0"
  style.stroke: "#C8C5BA"
  style.font-size: 15
  style.bold: true

  DonorRepository: { shape: class; "«interface»": "" }
  DonationRepository: { shape: class; "«interface»": "" }
  PaymentRepository: { shape: class; "«interface»": "" }
  EventRepository: { shape: class; "«interface»": "" }
  EventRegistrationRepository: { shape: class; "«interface»": "" }
  EventTypeRepository: { shape: class; "«interface»": "" }
  VolunteerRepository: { shape: class; "«interface»": "" }
  BeneficiaryRepository: { shape: class; "«interface»": "" }
}

impl: Implementations {
  style.fill: "#FFFFFF"
  style.stroke: "#B9B5A8"
  style.font-size: 14
  note: "Each contract is realized by a Sqlite*Repository\n(see module diagrams). Every Sqlite*Repository\nextends JdbcRepository." {
    shape: text
    style.font-size: 13
    style.font-color: "#6B675C"
    style.italic: true
  }
}

AuditLog: { shape: class; "«model» AuditLog": "" }

core.singletons.DatabaseManager -> core.singletons.ConfigManager: "reads db.url" { style.font-size: 13; style.font-color: "#6B675C" }
core.JdbcRepository -> core.singletons.DatabaseManager: "default connection" { style.font-size: 13; style.font-color: "#6B675C" }
core.singletons.AuditLogManager -> AuditLog: "records" { style.font-size: 13; style.font-color: "#6B675C" }
core.TransactionManager -> core.singletons.DatabaseManager: "shares connection" { style.stroke-dash: 4; style.font-size: 12; style.font-color: "#6B675C" }

