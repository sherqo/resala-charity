# Resala Charity — Donation module (Factory · Strategy-ish receipts · Observer subject)
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
  }
}

direction: right

donation: com.resala.donation {
  style.fill: "#F5F4F0"
  style.stroke: "#C8C5BA"
  style.font-size: 15
  style.bold: true

  factory: "«pattern» Factory Method" {
    style.stroke-dash: 5
    style.stroke: "#174E5B"
    style.fill: "#FDFDFB"
    style.font-size: 14
    style.font-color: "#174E5B"
    style.bold: true

    Donation: {
      shape: class
      "«abstract product»": ""
      "-id": long
      "-donorId": long
      "-type": DonationType
      "-donationDate": LocalDate
      "-referenceNumber": String
      "-notes": String
      "-status": DonationStatus
      "+getId()": long
      "+getDonorId()": long
      "+getType()": DonationType
      "+getStatus()": DonationStatus
      "+getAmountMinor()": long
      "+getItemDescription()": String
      "+getQuantity()": Integer
      "+getEstimatedValueMinor()": Long
    }

    OnlineDonation: {
      shape: class
      "«final product»": ""
      "-amountMinor": long
      "+getAmountMinor()": long
    }

    CheckDonation: {
      shape: class
      "«final product»": ""
      "-amountMinor": long
      "+getAmountMinor()": long
    }

    InKindDonation: {
      shape: class
      "«final product»": ""
      "-itemDescription": String
      "-quantity": int
      "-estimatedValueMinor": Long
      "+getAmountMinor()": long
      "+getItemDescription()": String
    }

    DonationFactory: {
      shape: class
      "«creator»": ""
      "+create(DonationRequest)": Donation
    }
  }

  DonationRequest: {
    shape: class
    "«record»": ""
    "donorId": long
    "type": DonationType
    "amountMinor": Long
    "itemDescription": String
    "quantity": Integer
    "estimatedValueMinor": Long
    "referenceNumber": String
    "donationDate": LocalDate
    "notes": String
  }

  DonationFilter: {
    shape: class
    "«record»": ""
    "donorId": Long
    "type": DonationType
    "from": LocalDate
    "to": LocalDate
  }

  DonationStatus: {
    shape: class
    "«enum»": "PENDING · COMPLETED · CANCELLED · REFUNDED · FAILED"
  }

  DonationRepository: {
    shape: class
    "«interface»": ""
    "+save(Donation)": Donation
    "+findById(long)": "Optional<Donation>"
    "+find(DonationFilter)": "List<Donation>"
    "+monetaryTotalForDonorYear(long, int)": long
    "+delete(long)": void
    "+update(DonationRequest, long)": Donation
    "+findByReferenceNumber(String)": "Optional<Donation>"
  }

  DonorRepository: {
    shape: class
    "«interface»": ""
    "+save(Donor)": Donor
    "+findById(long)": "Optional<Donor>"
    "+findActive(String)": "List<Donor>"
    "+archive(long)": void
  }

  DonationService: {
    shape: class
    "-donors": DonorRepository
    "-donations": DonationRepository
    "-payments": PaymentRepository
    "-observers": "List<DonationObserver>"
    "+saveDonor(Donor)": Donor
    "+record(DonationRequest)": Donation
    "+recordConfirmed(DonationRequest)": Donation
    "+findDonations(DonationFilter)": "List<Donation>"
    "+updateDonation(DonationRequest, long)": Donation
    "+deleteDonation(long)": void
    "+receipt(long)": String
    "+yearlyStatement(long, int)": String
    "+addObserver(DonationObserver)": void
    "+removeObserver(DonationObserver)": void
    "+notifyRecorded(Donation, Donor)": void
  }

  DonationPaymentSettlement: {
    shape: class
    "-donations": DonationService
    "+referenceType()": String
    "+settle(Payment)": long
    "+afterCommit(Payment, long)": void
  }

  decorator: "«pattern» Decorator" {
    style.stroke-dash: 5
    style.stroke: "#174E5B"
    style.fill: "#FDFDFB"
    style.font-size: 14
    style.font-color: "#174E5B"
    style.bold: true

    Receipt: {
      shape: class
      "«component interface»": ""
      "+render()": String
    }

    BasicReceipt: {
      shape: class
      "«concrete component»": ""
      "-donation": Donation
      "-donor": Donor
      "+render()": String
    }

    ReceiptDecorator: {
      shape: class
      "«abstract decorator»": ""
      "#receipt": Receipt
    }

    TaxReceiptDecorator: {
      shape: class
      "«concrete decorator»": ""
      "+render()": String
    }

    ThankYouReceiptDecorator: {
      shape: class
      "«concrete decorator»": ""
      "+render()": String
    }
  }
}

sqlite: persistence.sqlite {
  style.fill: "#F5F4F0"
  style.stroke: "#C8C5BA"
  style.font-size: 15
  style.bold: true

  SqliteDonorRepository: {
    shape: class
    "-DONOR_MAPPER": "RowMapper<Donor>"
  }
  SqliteDonationRepository: {
    shape: class
    "-DONATION_MAPPER": "RowMapper<Donation>"
  }
}

external: Collaborators {
  style.fill: "#FDFDFB"
  style.stroke: "#D8D5C9"
  style.font-size: 14
  style.bold: true

  Donor: { shape: class; "«model»": "" }
  DonationType: { shape: class; "«enum» ONLINE · CHECK · IN_KIND": "" }
  PaymentRepository: { shape: class; "«payment interface»": "" }
  DonationSubject: { shape: class; "«notification» interface DonationSubject": "" }
  DonationObserver: { shape: class; "«notification» interface DonationObserver": "" }
  Payment: { shape: class; "«payment»": "" }
  PaymentSettlement: { shape: class; "«payment» interface PaymentSettlement": "" }
  JdbcRepository: { shape: class; "«core abstract» JdbcRepository": "" }
}

donation.factory.OnlineDonation -> donation.factory.Donation: extends { target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
donation.factory.CheckDonation -> donation.factory.Donation: extends { target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
donation.factory.InKindDonation -> donation.factory.Donation: extends { target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }

donation.factory.DonationFactory -> donation.factory.OnlineDonation: creates { style.stroke-dash: 4; style.font-size: 12; style.font-color: "#6B675C" }
donation.factory.DonationFactory -> donation.factory.CheckDonation: creates { style.stroke-dash: 4; style.font-size: 12; style.font-color: "#6B675C" }
donation.factory.DonationFactory -> donation.factory.InKindDonation: creates { style.stroke-dash: 4; style.font-size: 12; style.font-color: "#6B675C" }
donation.factory.DonationFactory -> donation.DonationRequest: takes { style.stroke-dash: 4; style.font-size: 12; style.font-color: "#6B675C" }

donation.factory.Donation -> external.DonationType: ""
donation.factory.Donation -> donation.DonationStatus: ""
donation.DonationService -> donation.DonorRepository: ""
donation.DonationService -> donation.DonationRepository: ""
donation.DonationService -> external.PaymentRepository: "online payments" { style.font-size: 12; style.font-color: "#6B675C" }
donation.DonationService -> donation.factory.DonationFactory: "creates" { style.font-size: 12; style.font-color: "#6B675C" }
donation.DonationService -> external.DonationSubject: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
donation.DonationService -> external.DonationObserver: "notifies" { style.font-size: 12; style.font-color: "#6B675C" }

donation.DonationPaymentSettlement -> external.PaymentSettlement: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
donation.DonationPaymentSettlement -> donation.DonationService: "settles to" { style.font-size: 12; style.font-color: "#6B675C" }
donation.DonationPaymentSettlement -> external.Payment: ""

donation.decorator.BasicReceipt -> donation.decorator.Receipt: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
donation.decorator.TaxReceiptDecorator -> donation.decorator.ReceiptDecorator: extends { target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
donation.decorator.ThankYouReceiptDecorator -> donation.decorator.ReceiptDecorator: extends { target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
donation.decorator.ReceiptDecorator -> donation.decorator.Receipt: "implements · wraps" { style.stroke-dash: 4; target-arrowhead: { shape: diamond }; style.font-size: 12; style.font-color: "#6B675C" }

sqlite.SqliteDonorRepository -> donation.DonorRepository: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
sqlite.SqliteDonationRepository -> donation.DonationRepository: implements { style.stroke-dash: 4; target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
sqlite.SqliteDonorRepository -> external.JdbcRepository: extends { target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
sqlite.SqliteDonationRepository -> external.JdbcRepository: extends { target-arrowhead: { shape: triangle }; style.font-size: 12; style.font-color: "#6B675C" }
