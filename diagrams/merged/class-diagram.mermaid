classDiagram
direction LR

namespace Models {
  class Donor {
    long id
    String name
    Type type
    String email
    String phone
    boolean active
  }
  class Donation {
    <<abstract>>
    long id
    long donorId
    DonationType type
    LocalDate donationDate
    DonationStatus status
  }
  class OnlineDonation
  class CheckDonation
  class InKindDonation
  class Volunteer {
    int id
    String name
    String email
    String phone
    boolean available
  }
  class Skill
  class Event {
    int id
    String title
    int eventTypeId
    LocalDate date
    int capacity
    int hours
    Status status
  }
  class EventType
  class EventRegistration
  class Beneficiary {
    long id
    String name
    int householdSize
    int needTypeId
    Status status
    int impactScore
  }
  class NeedType
  class Distribution
  class Payment
  class VolunteerEventAssignment
}

namespace DonationModule {
  class DonationFactory {
    create(DonationRequest) Donation
  }
  class Receipt {
    <<interface>>
    render() String
  }
  class BasicReceipt
  class ReceiptDecorator
  class TaxReceiptDecorator
  class ThankYouReceiptDecorator
  class DonationService
  class DonationController
  class DonorRepository {
    <<interface>>
  }
  class DonationRepository {
    <<interface>>
  }
  class DonationPaymentSettlement
}

namespace EventAndVolunteer {
  class EventService
  class EventTypeService
  class VolunteerService
  class EventController
  class VolunteerController
  class EventRepository {
    <<interface>>
  }
  class EventRegistrationRepository {
    <<interface>>
  }
  class EventTypeRepository {
    <<interface>>
  }
  class VolunteerRepository {
    <<interface>>
  }
}

namespace BeneficiaryModule {
  class BeneficiaryService
  class BeneficiaryController
  class BeneficiaryRepository {
    <<interface>>
  }
  class DistributionPolicy {
    <<interface>>
    allocate()
  }
  class ByNeedDistributionPolicy
  class EqualDistributionPolicy
  class FifoDistributionPolicy
}

namespace Notification {
  class DonationSubject {
    <<interface>>
  }
  class DonationObserver {
    <<interface>>
    onDonationRecorded()
  }
  class EventSubject {
    <<interface>>
  }
  class EventObserver {
    <<interface>>
    onEventUpdated()
  }
  class ThankYouNotificationObserver
  class FeedObserver
  class EventNotificationObserver
  class Notifier
  class NotificationStrategy {
    <<interface>>
    send()
  }
  class EmailStrategy
  class SmsStrategy
  class SocialStrategy
}

namespace PaymentSimulation {
  class PaymentService
  class PaymentController
  class PaymentRepository {
    <<interface>>
  }
  class PaymentGateway {
    <<interface>>
    charge(PaymentCommand) GatewayResult
  }
  class FakePaymentGatewayAdapter
  class FakePaymentProvider
  class PaymentSettlement {
    <<interface>>
    settle(Payment) long
  }
  class PaymentMethod {
    <<interface>>
    validate() tokenize()
  }
  class CashPaymentMethod
  class CardPaymentMethod
  class WalletPaymentMethod
}

namespace MVC {
  class AppShell
  class DonationView
  class EventView
  class VolunteerView
  class BeneficiaryView
  class LookupView
  class PaymentView
  class DashboardView
}

namespace Shared {
  class DatabaseManager {
    <<singleton>>
    getInstance()
  }
  class ConfigManager {
    <<singleton>>
    getInstance()
  }
  class AuditLogManager {
    <<singleton>>
    getInstance()
  }
  class JdbcRepository {
    <<abstract>>
  }
  class SqliteDonationRepository
  class SqliteDonorRepository
  class SqliteEventRepository
  class SqliteEventRegistrationRepository
  class SqliteEventTypeRepository
  class SqliteVolunteerRepository
  class SqliteBeneficiaryRepository
  class SqlitePaymentRepository
}

Donor "1" --> "*" Donation : donorId
Donation <|-- OnlineDonation
Donation <|-- CheckDonation
Donation <|-- InKindDonation
DonationFactory ..> Donation : creates
Receipt <|.. BasicReceipt
Receipt <|.. ReceiptDecorator
ReceiptDecorator o-- Receipt : wraps
ReceiptDecorator <|-- TaxReceiptDecorator
ReceiptDecorator <|-- ThankYouReceiptDecorator
DonationController --> DonationService
DonationService --> DonorRepository
DonationService --> DonationRepository
DonationService ..> DonationFactory
DonationService ..|> DonationSubject
DonationSubject --> DonationObserver : notifies
ThankYouNotificationObserver ..|> DonationObserver
DonationPaymentSettlement ..|> PaymentSettlement
DonationPaymentSettlement --> DonationService

Event "1" --> "*" EventRegistration
Event --> EventType : eventTypeId
EventController --> EventService
EventController --> EventTypeService
EventController --> VolunteerService
EventService --> EventRepository
EventService --> EventRegistrationRepository
EventService ..|> EventSubject
EventSubject --> EventObserver : notifies
EventNotificationObserver ..|> EventObserver
FeedObserver ..|> DonationObserver
FeedObserver ..|> EventObserver
VolunteerController --> VolunteerService
VolunteerService --> VolunteerRepository
VolunteerService --> EventRepository
VolunteerService --> EventRegistrationRepository
Volunteer "*" -- "*" Skill
VolunteerEventAssignment --> Volunteer : volunteerId
VolunteerEventAssignment --> Event : eventId
VolunteerEventAssignment --> Skill : skillId

Beneficiary --> NeedType : needTypeId
Distribution --> Beneficiary : beneficiaryId
BeneficiaryService --> BeneficiaryRepository
BeneficiaryController --> BeneficiaryService
BeneficiaryService --> DistributionPolicy
ByNeedDistributionPolicy ..|> DistributionPolicy
EqualDistributionPolicy ..|> DistributionPolicy
FifoDistributionPolicy ..|> DistributionPolicy

Notifier --> NotificationStrategy : uses
EmailStrategy ..|> NotificationStrategy
SmsStrategy ..|> NotificationStrategy
SocialStrategy ..|> NotificationStrategy

PaymentService --> PaymentRepository
PaymentService --> PaymentGateway
PaymentService --> PaymentSettlement
PaymentService ..> Payment : creates and updates
FakePaymentGatewayAdapter ..|> PaymentGateway
FakePaymentGatewayAdapter --> FakePaymentProvider : adapts
PaymentMethod <|.. CashPaymentMethod
PaymentMethod <|.. CardPaymentMethod
PaymentMethod <|.. WalletPaymentMethod

AppShell o-- DonationView
AppShell o-- EventView
AppShell o-- VolunteerView
AppShell o-- BeneficiaryView
AppShell o-- LookupView
AppShell o-- PaymentView
AppShell o-- DashboardView
DonationView --> DonationController
EventView --> EventController
VolunteerView --> VolunteerController
BeneficiaryView --> BeneficiaryController
PaymentView --> PaymentController
PaymentController --> PaymentService
LookupView --> EventController
LookupView --> VolunteerController
DashboardView ..|> DonationObserver
DashboardView ..|> EventObserver

JdbcRepository --> DatabaseManager
DatabaseManager --> ConfigManager
SqliteDonationRepository --|> JdbcRepository
SqliteDonationRepository ..|> DonationRepository
SqliteDonorRepository --|> JdbcRepository
SqliteDonorRepository ..|> DonorRepository
SqliteEventRepository --|> JdbcRepository
SqliteEventRepository ..|> EventRepository
SqliteEventRegistrationRepository --|> JdbcRepository
SqliteEventRegistrationRepository ..|> EventRegistrationRepository
SqliteEventTypeRepository --|> JdbcRepository
SqliteEventTypeRepository ..|> EventTypeRepository
SqliteVolunteerRepository --|> JdbcRepository
SqliteVolunteerRepository ..|> VolunteerRepository
SqliteBeneficiaryRepository --|> JdbcRepository
SqliteBeneficiaryRepository ..|> BeneficiaryRepository
SqlitePaymentRepository --|> JdbcRepository
SqlitePaymentRepository ..|> PaymentRepository
