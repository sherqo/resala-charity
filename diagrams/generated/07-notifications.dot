digraph classdiagram {
  graph [rankdir=TB, splines=polyline, nodesep=0.35, ranksep=1.1,
         compound=true, newrank=true,
         fontname="Helvetica", fontsize=22, labelloc="t", label="Notifications, observers and audit"];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#5f6b7a"];

  subgraph cluster_0 {
    label="core"; fontsize=13; fontcolor="#344054";
    style="rounded,dashed"; color="#c7ccd4"; penwidth=1;
    "com.resala.core.AuditLogManager" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#e1d5e7' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>AuditLogManager</B></FONT></TD></TR><TR><TD BGCOLOR='#e1d5e7' ALIGN='CENTER'><FONT POINT-SIZE='10'><I>&laquo;singleton&raquo;</I></FONT></TD></TR><TR><TD ALIGN='LEFT'>- counter: AtomicLong<BR/>- logs: ObservableList&lt;AuditLog&gt;</TD></TR><TR><TD ALIGN='LEFT'>+ AuditLogManager()<BR/>+ getInstance(): AuditLogManager<BR/>+ log(String, String, String, String, String, String)<BR/>- addEntry(AuditLog)<BR/>+ getLogs(): ObservableList&lt;AuditLog&gt;<BR/>+ clear()</TD></TR></TABLE>>];
    "com.resala.core.ConfigManager" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#e1d5e7' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>ConfigManager</B></FONT></TD></TR><TR><TD BGCOLOR='#e1d5e7' ALIGN='CENTER'><FONT POINT-SIZE='10'><I>&laquo;singleton&raquo;</I></FONT></TD></TR><TR><TD ALIGN='LEFT'><U>- instance: ConfigManager</U><BR/>- props: Properties</TD></TR><TR><TD ALIGN='LEFT'>+ ConfigManager()<BR/>+ getInstance(): ConfigManager<BR/>+ get(String): String</TD></TR></TABLE>>];
    "com.resala.core.DatabaseManager" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#e1d5e7' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>DatabaseManager</B></FONT></TD></TR><TR><TD BGCOLOR='#e1d5e7' ALIGN='CENTER'><FONT POINT-SIZE='10'><I>&laquo;singleton&raquo;</I></FONT></TD></TR><TR><TD ALIGN='LEFT'><U>- instance: DatabaseManager</U><BR/>- connection: Connection</TD></TR><TR><TD ALIGN='LEFT'>+ DatabaseManager()<BR/>+ getInstance(): DatabaseManager<BR/>+ getConnection(): Connection<BR/>+ close()<BR/>- runScript(String)<BR/>- migrate(Connection)<BR/>- readResource(String): String<BR/>- createParentDirectory(String)</TD></TR></TABLE>>];
    "com.resala.core.JdbcRepository" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#e1d5e7' ALIGN='CENTER'><FONT POINT-SIZE='14'><I><B>JdbcRepository</B></I></FONT></TD></TR><TR><TD ALIGN='LEFT'># conn: Connection</TD></TR><TR><TD ALIGN='LEFT'>+ JdbcRepository(Connection)<BR/># execute(String, Object...): int<BR/># query(String, JdbcRepository$RowMapper, Object...): &lt;T&gt; List&lt;T&gt;<BR/># queryOne(String, JdbcRepository$RowMapper, Object...): &lt;T&gt; Optional&lt;T&gt;<BR/># insertReturnKey(String, Object...): long<BR/>- bind(PreparedStatement, Object...)<BR/>- dbError(String, SQLException): RuntimeException<BR/># str(ResultSet, String): String<BR/># num(ResultSet, String): int<BR/># lng(ResultSet, String): long<BR/><I>... 1 more</I></TD></TR></TABLE>>];
    "com.resala.core.TransactionManager" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#e1d5e7' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>TransactionManager</B></FONT></TD></TR><TR><TD ALIGN='LEFT'>- connection: Connection</TD></TR><TR><TD ALIGN='LEFT'>+ TransactionManager(Connection)<BR/>+ inTransaction(Supplier): &lt;T&gt; T</TD></TR></TABLE>>];
  }
  subgraph cluster_1 {
    label="notification"; fontsize=13; fontcolor="#344054";
    style="rounded,dashed"; color="#c7ccd4"; penwidth=1;
    "com.resala.notification.DonationObserver" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>DonationObserver</B></FONT></TD></TR><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='10'><I>&laquo;interface&raquo;</I></FONT></TD></TR><TR><TD ALIGN='LEFT'>+ onDonationRecorded(Donation, Donor)</TD></TR></TABLE>>];
    "com.resala.notification.DonationSubject" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>DonationSubject</B></FONT></TD></TR><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='10'><I>&laquo;interface&raquo;</I></FONT></TD></TR><TR><TD ALIGN='LEFT'>+ addObserver(DonationObserver)<BR/>+ removeObserver(DonationObserver)</TD></TR></TABLE>>];
    "com.resala.notification.EmailStrategy" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>EmailStrategy</B></FONT></TD></TR><TR><TD ALIGN='LEFT'>+ EmailStrategy()<BR/>+ send(String, String, String)</TD></TR></TABLE>>];
    "com.resala.notification.EventNotificationObserver" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>EventNotificationObserver</B></FONT></TD></TR><TR><TD ALIGN='LEFT'>- registrationRepository: EventRegistrationRepository<BR/>- notifier: Notifier</TD></TR><TR><TD ALIGN='LEFT'>+ EventNotificationObserver(EventRegistrationRepository, Notifier)<BR/>+ onEventUpdated(Event, String)</TD></TR></TABLE>>];
    "com.resala.notification.EventObserver" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>EventObserver</B></FONT></TD></TR><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='10'><I>&laquo;interface&raquo;</I></FONT></TD></TR><TR><TD ALIGN='LEFT'>+ onEventUpdated(Event, String)</TD></TR></TABLE>>];
    "com.resala.notification.EventSubject" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>EventSubject</B></FONT></TD></TR><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='10'><I>&laquo;interface&raquo;</I></FONT></TD></TR><TR><TD ALIGN='LEFT'>+ addObserver(EventObserver)<BR/>+ removeObserver(EventObserver)</TD></TR></TABLE>>];
    "com.resala.notification.FeedObserver" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>FeedObserver</B></FONT></TD></TR><TR><TD ALIGN='LEFT'>- feedList: ListView&lt;String&gt;<BR/>- statusLabel: Label<BR/>- timeFormatter: DateTimeFormatter</TD></TR><TR><TD ALIGN='LEFT'>+ FeedObserver(ListView, Label)<BR/>+ onDonationRecorded(Donation, Donor)<BR/>+ onEventUpdated(Event, String)<BR/>- addToFeed(String)</TD></TR></TABLE>>];
    "com.resala.notification.NotificationStrategy" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>NotificationStrategy</B></FONT></TD></TR><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='10'><I>&laquo;interface&raquo;</I></FONT></TD></TR><TR><TD ALIGN='LEFT'>+ send(String, String, String)</TD></TR></TABLE>>];
    "com.resala.notification.Notifier" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>Notifier</B></FONT></TD></TR><TR><TD ALIGN='LEFT'>- strategy: NotificationStrategy</TD></TR><TR><TD ALIGN='LEFT'>+ Notifier(NotificationStrategy)<BR/>+ setStrategy(NotificationStrategy)<BR/>+ send(String, String, String)</TD></TR></TABLE>>];
    "com.resala.notification.SmsStrategy" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>SmsStrategy</B></FONT></TD></TR><TR><TD ALIGN='LEFT'>+ SmsStrategy()<BR/>+ send(String, String, String)</TD></TR></TABLE>>];
    "com.resala.notification.SocialStrategy" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>SocialStrategy</B></FONT></TD></TR><TR><TD ALIGN='LEFT'>+ SocialStrategy()<BR/>+ send(String, String, String)</TD></TR></TABLE>>];
    "com.resala.notification.ThankYouNotificationObserver" [label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='4'><TR><TD BGCOLOR='#fff2cc' ALIGN='CENTER'><FONT POINT-SIZE='14'><B>ThankYouNotificationObserver</B></FONT></TD></TR><TR><TD ALIGN='LEFT'>- notifier: Notifier</TD></TR><TR><TD ALIGN='LEFT'>+ ThankYouNotificationObserver(Notifier)<BR/>+ onDonationRecorded(Donation, Donor)</TD></TR></TABLE>>];
  }

  "com.resala.notification.EmailStrategy" -> "com.resala.notification.NotificationStrategy" [style=dashed, arrowhead=onormal];
