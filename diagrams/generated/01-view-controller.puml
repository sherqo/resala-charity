package "com.resala.gui" {
  class AppShell <<singleton>> {
    -stage: Stage
    -views: Map<String, BaseView>
    -feedList: ListView<String>
    -statusLabel: Label
    -currentView: BaseView
    -donationController: DonationController
    -eventController: EventController
    -volunteerController: VolunteerController
    -paymentController: PaymentController
    -paymentService: PaymentService
    -beneficiaryController: BeneficiaryController
    -notifier: Notifier
    -donationSubject: DonationSubject
    -eventSubject: EventSubject
    -feedObserver: FeedObserver
    -toast: Toast
    -confirmDialog: ConfirmDialog
    -instance: AppShell
    -rootPane: StackPane
    -mainLayout: BorderPane
    -modalOverlay: StackPane
    -navItems: List<AppShell$NavItem>
    -headerBar: AppShell$HeaderBar
    -contentStack: StackPane
    +getInstance()
    +getStage()
    +getToast()
    +getConfirmDialog()
    +getFeedList()
    +getModalOverlay()
    +show()
    -buildRoot()
    -buildSidebar()
    -buildMainPane()
    -buildStatusBar()
    -buildViews()
    +refreshAll()
    +showView()
    -getSubtitle()
  }
  class BaseView {
    #toolbar: HBox
    #table: DataTable<?>
    +getTableView()
    +refresh()
    +getPrimaryAction()
  }
  interface Refreshable <<interface>> {
    +refresh()
  }
}
