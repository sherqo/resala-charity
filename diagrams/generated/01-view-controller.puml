package "com.resala.view" {
  interface "BeneficiaryView" as BeneficiaryView_view <<interface>> {
    +start()
  }
  interface "DonationView" as DonationView_view <<interface>> {
    +start()
  }
  interface "EventView" as EventView_view <<interface>> {
    +start()
  }
  interface UiFactory <<interface>> {
    +createDonationView()
    +createEventView()
    +createBeneficiaryView()
    +createVolunteerView()
  }
  interface "VolunteerView" as VolunteerView_view <<interface>> {
    +start()
  }
}
