  "com.resala.beneficiary.policy.ByNeedDistributionPolicy" -> "com.resala.beneficiary.policy.DistributionPolicy" [style=dashed, arrowhead=onormal];
  "com.resala.beneficiary.policy.EqualDistributionPolicy" -> "com.resala.beneficiary.policy.DistributionPolicy" [style=dashed, arrowhead=onormal];
  "com.resala.beneficiary.policy.FifoDistributionPolicy" -> "com.resala.beneficiary.policy.DistributionPolicy" [style=dashed, arrowhead=onormal];
}
