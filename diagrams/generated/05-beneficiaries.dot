  "com.resala.beneficiary.BeneficiaryService" -> "com.resala.beneficiary.BeneficiaryRepository" [style=solid, arrowhead=vee];
  "com.resala.beneficiary.BeneficiaryService" -> "com.resala.beneficiary.Distribution" [style=dashed, arrowhead=vee];
